# Killer Kalculator — environment variables
#
# Copy this file to .env and fill in real values before starting the server locally.
# .env is listed in .gitignore and is never served to clients.
#
# Local development: load this file with a tool that sets env vars before starting
# the server (e.g. `node --env-file=.env server.js`, or `dotenv -e .env -- node server.js`).
# The application does NOT auto-load .env — env vars must be present in the process
# environment when the server starts.
#
# Railway (production): set these as Railway environment variables in the project
# settings, not in a deployed file.
#
# All variables below are required.  The server will exit at startup if any are missing.

# ── Auth ──────────────────────────────────────────────────────────────────────
# Generate with: node -e "require('crypto').randomBytes(32).toString('hex').split('').forEach(c=>process.stdout.write(c))"
KK_SESSION_SECRET=replace-with-random-64-hex-chars

# Username shown on the login screen
KK_USERNAME=replace-with-login-username

# bcrypt hash of the login password.
# Generate with: node scripts/generate-password-hash.js
KK_PASSWORD_HASH=replace-with-bcrypt-hash

# ── Planday ───────────────────────────────────────────────────────────────────
PLANDAY_APP_ID=replace-with-planday-app-id
PLANDAY_REFRESH_TOKEN=replace-with-planday-refresh-token

# ── OnlinePOS — one token per store ───────────────────────────────────────────
ONLINEPOS_TOKEN_INDRE_BY=replace-with-indre-by-token
ONLINEPOS_TOKEN_VESTERBRO=replace-with-vesterbro-token
ONLINEPOS_TOKEN_CHRISTIANSHAVN=replace-with-christianshavn-token
ONLINEPOS_TOKEN_FISKETORVET=replace-with-fisketorvet-token
ONLINEPOS_TOKEN_FREDERIKSBERG=replace-with-frederiksberg-token
ONLINEPOS_TOKEN_NORREBRO=replace-with-norrebro-token

# ── Optional ──────────────────────────────────────────────────────────────────
# Required only for invoice scanning. Omit to disable that feature.
# ANTHROPIC_API_KEY=replace-with-anthropic-api-key
